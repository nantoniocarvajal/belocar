# Variables usadas por docker-compose.yml para levantar MySQL + backend + frontend juntos.
# Copia este archivo a ".env" (en la raíz del proyecto) y ajusta los valores.

# --- Base de datos ---
DB_NAME=belocar
DB_USER=belocar
DB_PASSWORD=belocar
DB_ROOT_PASSWORD=belocar_root
DB_PORT=3306

# --- Backend ---
SERVER_PORT=8080
# Secreto usado para firmar los JWT del panel admin. Genera uno propio y único, no uses este valor en producción.
JWT_SECRET=dev-secret-change-me-please-this-is-not-for-production-use-only-local
JWT_EXPIRATION_MINUTES=480
# Origen(es) permitido(s) para CORS, separados por coma. Debe incluir la URL del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Número de WhatsApp por defecto (solo se usa para inicializar site_config la primera vez).
# El número real se administra después desde el panel de administración.
WHATSAPP_DEFAULT_NUMBER=56900000000

# Credenciales del administrador creadas SOLO si la tabla admin_users está vacía (primer arranque).
# Cambia la contraseña apenas tengas acceso al panel; no dejes estos valores en producción.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme123

# --- Frontend (solo si lo levantas con docker-compose en vez de "npm run dev") ---
FRONTEND_PORT=5173
# URL del backend que el navegador va a usar. Se incrusta en el build, asi que si cambias
# esto hay que reconstruir la imagen del frontend (docker compose up -d --build frontend).
VITE_API_BASE_URL=http://localhost:8080
