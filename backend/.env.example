# Variables para correr el backend directamente con Maven/tu IDE (sin Docker).
# Copia este archivo a ".env" dentro de /backend, o exporta las mismas variables en tu shell/IDE.
# Si vas a usar docker-compose en vez de esto, usa el .env.example de la raíz del proyecto.

SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/belocar?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Santiago&useUnicode=true&characterEncoding=UTF-8
DB_USER=belocar
DB_PASSWORD=belocar

JWT_SECRET=dev-secret-change-me-please-this-is-not-for-production-use-only-local
JWT_EXPIRATION_MINUTES=480

CORS_ALLOWED_ORIGINS=http://localhost:5173

FILE_STORAGE_LOCAL_DIR=uploads
FILE_STORAGE_PUBLIC_BASE_URL=/uploads

WHATSAPP_DEFAULT_NUMBER=56900000000

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme123
